# Cloudflare Pages edge cache headers.
# Hashed Next.js build assets are safe to cache forever. Optimized image
# variants and source images are content-stable (re-uploaded under the same
# path only when the source file itself changes), so a long cache with
# revalidation headroom is safe there too.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/_opt/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
